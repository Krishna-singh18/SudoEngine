{
  "name": "sudoku-solver",
  "version": "1.0.0",
  "description": "Production-level Sudoku Solver with C++ engine, Node.js API, and Vanilla JS frontend",
  "main": "backend/server.js",
  "scripts": {
    "start": "node backend/server.js",
    "build:cpp": "g++ -O2 -std=c++17 -o cpp/solver cpp/solver.cpp",
    "dev": "npm run build:cpp && node backend/server.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.2"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "keywords": ["sudoku", "solver", "cpp", "nodejs", "express"],
  "author": "Krishna Singh",
  "license": "MIT"
}
